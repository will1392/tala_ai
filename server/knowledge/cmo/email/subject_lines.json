  {
    "id": "email-subject-formulas",
    "type": "template",
    "topic": "subject_lines",
    "title": "High-Converting Subject Line Formulas",
    "templates": [
      {
        "name": "Urgency",
        "pattern": "{Time Limit}: {Benefit}",
        "examples": [
          "Last 24 Hours: 50% Off Everything",
          "Ends Tonight: Your Exclusive Access",
          "48 Hour Flash Sale Starts Now"
        ],
        "use_case": "Limited-time offers, sales, event registrations"
      },
      {
        "name": "Curiosity Gap",
        "pattern": "{Intriguing Statement} (You Won't Believe #{Number})",
        "examples": [
          "The Email Mistake That's Costing You Sales",
          "This Simple Trick Doubled Our Conversions",
          "What Amazon Doesn't Want You to Know"
        ],
        "use_case": "Content marketing, newsletters, educational emails"
      },
      {
        "name": "Personalization",
        "pattern": "{First_name}, {Question or Statement}",
        "examples": [
          "John, your cart is waiting",
          "Sarah, you've earned a reward",
          "Mike, quick question for you"
        ],
        "use_case": "Transactional, re-engagement, personal offers"
      },
      {
        "name": "Benefit-Focused",
        "pattern": "How to {Achieve Desired Outcome}",
        "examples": [
          "How to Save $500 on Your Next Flight",
          "How to Write Emails That Get 50% Opens",
          "How to Get Your First 1,000 Subscribers"
        ],
        "use_case": "Educational content, lead nurturing"
      }
    ]
  },
