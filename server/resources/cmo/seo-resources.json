      "id": "seo-high-converting-title",
      "type": "example",
      "title": "High-Converting Product Page Title",
      "description": "E-commerce title that increased CTR by 35%",
      "content": "Buy [Product Name] - Free Shipping | Save 20% Today | [Brand]",
      "category": "title-tags",
