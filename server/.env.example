# LLM Provider API Keys
# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google AI Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Grok (X.AI) Configuration
GROK_API_KEY=your-grok-api-key

# Local Llama Configuration
LLAMA_MODEL_PATH=./models/llama-3.1-8b.gguf

# Qdrant Configuration
QDRANT_URL=your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Storage Configuration
# Options: local, s3, cloudinary
STORAGE_TYPE=s3

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Cloudinary Configuration (if using Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_RETRY_DELAY=100
REDIS_MAX_RETRIES=3
REDIS_ENABLED=true
REDIS_LOGGING=false

# Cache Configuration
CACHE_TTL_DEFAULT=300
CACHE_TTL_SHORT=60
CACHE_TTL_LONG=600

# Authentication Configuration
# Global Authentication Settings
AUTH_DEFAULT_PROVIDER=local
AUTH_MULTI_PROVIDER=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_ENABLE_ACCOUNT_LOCKOUT=true
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=900000
AUTH_PASSWORD_RESET_EXPIRY=3600000

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production
SESSION_MAX_AGE=86400000
COOKIE_MAX_AGE=86400000

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW=900000
AUTH_RATE_LIMIT_MAX=5

# Local Authentication Provider
AUTH_LOCAL_ENABLED=true
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Password Requirements
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_REQUIRE_UPPERCASE=true
AUTH_REQUIRE_LOWERCASE=true
AUTH_REQUIRE_NUMBERS=true
AUTH_REQUIRE_SPECIAL_CHARS=true

# Default Admin Account (for development only)
AUTH_CREATE_DEFAULT_ADMIN=false
AUTH_DEFAULT_ADMIN_EMAIL=admin@tala.ai
AUTH_DEFAULT_ADMIN_PASSWORD=admin123

# Auth0 Provider (optional)
AUTH0_ENABLED=false
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=your-auth0-audience
AUTH0_SCOPE=openid profile email
AUTH0_CALLBACK_URL=http://localhost:3001/auth/auth0/callback
AUTH0_LOGOUT_URL=http://localhost:3000
AUTH0_CONNECTION=Username-Password-Authentication
AUTH0_LEEWAY=60
AUTH0_CACHE_TTL=3600

# Clerk Provider (optional)
CLERK_ENABLED=false
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_JWT_KEY=your-clerk-jwt-key
CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret
CLERK_WEBHOOK_PATH=/auth/clerk/webhook
CLERK_FRONTEND_API=your-clerk-frontend-api
CLERK_API_VERSION=v1
CLERK_SESSION_TOKEN_NAME=__session

# OAuth Providers (optional)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:3001/auth/microsoft/callback

# Email Service Configuration
EMAIL_SERVICE=smtp
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# SendGrid Configuration (alternative email service)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Tala AI

# Mailgun Configuration (alternative email service)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=Tala AI

# AWS SES Configuration (alternative email service)
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=Tala AI

# Authentication Database Configuration
AUTH_USE_EXISTING_DB=true
AUTH_DATABASE_URL=your-separate-auth-database-url
AUTH_USERS_TABLE=users
AUTH_SESSIONS_TABLE=user_sessions
AUTH_TOKENS_TABLE=auth_tokens

# Authentication Logging
AUTH_LOGGING_ENABLED=true
AUTH_LOG_LEVEL=info
AUTH_LOG_SUCCESS=false
AUTH_LOG_FAILED=true
AUTH_LOG_REFRESH=false
AUTH_LOG_PASSWORD_RESET=true
AUTH_MASK_SENSITIVE=true
AUTH_LOG_CONSOLE=true
AUTH_LOG_FILE=false
AUTH_LOG_DATABASE=false
AUTH_LOG_EXTERNAL=false

# Development/Testing Configuration
AUTH_BYPASS_EMAIL_VERIFICATION=false
AUTH_ALLOW_WEAK_PASSWORDS=false
AUTH_ENABLE_TEST_ROUTES=false
AUTH_CREATE_TEST_USERS=false
AUTH_TEST_USER_COUNT=5

# Auth0 Configuration
AUTH0_ENABLED=false
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=your-auth0-audience
AUTH0_SCOPE=openid profile email
AUTH0_CALLBACK_URL=http://localhost:3001/auth/callback/auth0
AUTH0_LOGOUT_URL=http://localhost:3000
AUTH0_CONNECTION=Username-Password-Authentication
AUTH0_LEEWAY=60
AUTH0_CACHE_TTL=3600
AUTH0_REQUIRED=false

# Clerk Configuration
CLERK_ENABLED=false
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_JWT_KEY=your-clerk-jwt-key
CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret
CLERK_WEBHOOK_PATH=/auth/callback/clerk
CLERK_FRONTEND_API=your-clerk-frontend-api
CLERK_API_VERSION=v1
CLERK_SESSION_TOKEN_NAME=__session
CLERK_DEV_BROWSER_TOKEN=your-clerk-dev-browser-token
CLERK_REQUIRED=false

# Mock Provider Configuration (Development)
MOCK_ENABLED=true
MOCK_TOKEN_EXPIRY=3600
MOCK_SIMULATE_LATENCY=false
MOCK_LATENCY_MS=100
MOCK_FAILURE_RATE=0