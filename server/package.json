{
  "name": "tala-backend",
  "version": "1.0.0",
  "description": "Tala AI Backend Server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node db/migrations/runMigrations.js",
    "migrate:rollback": "node db/migrations/rollback.js",
    "migrate:rollback:last": "node db/migrations/rollback.js last",
    "migrate:rollback:all": "node db/migrations/rollback.js all",
    "migrate:status": "node db/migrations/runMigrations.js status",
    "test:migrations": "node test-migrations.js",
    "test:redis": "node test-redis.js",
    "test:cache": "node test-cache-implementation.js",
    "test:db-integration": "node test-database-integration.js",
    "test:database": "node test-database.js",
    "test:endpoints": "node test-db-endpoints.js",
    "test:endpoints-mock": "node test-with-mock-env.js",
    "test:endpoints-full": "node test-api-endpoints-updated.js",
    "test:integration": "node test-integration-comprehensive.js",
    "test:integration-quick": "node test-quick-integration.cjs",
    "test:smart-pipeline": "NODE_OPTIONS='--experimental-vm-modules' jest test-smart-pipeline.js",
    "test:smart-pipeline:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest test-smart-pipeline.js --coverage",
    "seed": "node db/seed.js",
    "seed:dry-run": "node db/seed.js --dry-run --verbose",
    "verify:migration": "node scripts/verify-migration.js",
    "backup:db": "node scripts/backup-db.js",
    "backup:db-compressed": "node scripts/backup-db.js --compress --verify",
    "apply:schema": "node apply-schema.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@clerk/clerk-sdk-node": "^4.13.23",
    "@google-cloud/translate": "^7.2.2",
    "@google/generative-ai": "^0.24.1",
    "@qdrant/qdrant-js": "^1.5.0",
    "@supabase/supabase-js": "^2.50.5",
    "argon2": "^0.43.0",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-openid-connect": "^2.18.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "express-slow-down": "^2.1.0",
    "express-validator": "^7.2.1",
    "file-type": "^21.0.0",
    "franc": "^6.2.0",
    "googleapis": "^152.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "isomorphic-dompurify": "^2.26.0",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "langdetect": "^0.2.1",
    "lru-cache": "^11.1.0",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.3.1",
    "openai": "^5.9.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.1",
    "redis": "^5.6.0",
    "sharp": "^0.34.3",
    "string-similarity": "^4.0.4",
    "tesseract.js": "^4.1.1",
    "tiktoken": "^1.0.21",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.4",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "form-data": "^4.0.3",
    "jest": "^30.0.4",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3"
  }
}
