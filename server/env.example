# Tala AI Environment Configuration
# Copy this file to .env and fill in your actual values

# ================================
# SERVER CONFIGURATION
# ================================
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ================================
# MULTI-LLM CONFIGURATION
# ================================

# Feature Flag: Enable/Disable Multi-LLM routing
# Set to 'false' to use OpenAI-only mode (backward compatibility)
ENABLE_MULTI_LLM=true

# Budget Management (USD)
DAILY_LLM_BUDGET=50.00
MONTHLY_LLM_BUDGET=1000.00

# Model Fallback Chain (comma-separated, order matters)
LLM_FALLBACK_CHAIN=gpt-4o-mini,claude-sonnet-4-20250514,gemini-2.5-flash,grok-3-latest

# ================================
# LLM PROVIDER API KEYS
# ================================

# OpenAI (Required - used as fallback even in multi-LLM mode)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (Optional - for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google AI (Optional - for Gemini models)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Grok (Optional - for Grok models, when available)
GROK_API_KEY=your-grok-api-key-here

# ================================
# VECTOR DATABASE (QDRANT)
# ================================
QDRANT_URL=https://your-cluster-url.qdrant.tech:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# ================================
# CLOUD STORAGE (OPTIONAL)
# ================================

# Storage Type: 'local', 'aws', 'azure', 'gcp'
STORAGE_TYPE=local

# AWS S3 Configuration (if using AWS)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Azure Blob Storage (if using Azure)
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_STORAGE_CONTAINER=your-container-name

# Google Cloud Storage (if using GCP)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_STORAGE_BUCKET=your-gcs-bucket
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ================================
# DATABASE CONFIGURATION (SUPABASE)
# ================================

# Supabase PostgreSQL Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Database Migration Settings
ENABLE_DUAL_WRITE=false          # Write to both JSON and database
ENABLE_DATABASE_READ=false       # Read from database instead of JSON
FALLBACK_TO_JSON=true           # Fallback to JSON if database fails

# Database Performance
DB_POOL_SIZE=10                 # Connection pool size
DB_QUERY_TIMEOUT=30000          # Query timeout in milliseconds
DB_ENABLE_LOGGING=false         # Enable SQL query logging

# ================================
# ADVANCED CONFIGURATION
# ================================

# Enable debug logging
DEBUG=false

# Health check interval (milliseconds)
HEALTH_CHECK_INTERVAL=300000

# Request timeout (milliseconds)
REQUEST_TIMEOUT=30000

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=100

# ================================
# MIGRATION NOTES
# ================================

# For migration from OpenAI-only:
# 1. Start with ENABLE_MULTI_LLM=false to test compatibility
# 2. Add one provider API key at a time
# 3. Monitor costs carefully with the new budget settings
# 4. Use http://localhost:3001/api/health to verify setup
# 5. Access metrics at http://localhost:3001/api/llm/metrics

# Rollback procedure:
# Set ENABLE_MULTI_LLM=false and restart server
# All functionality will work exactly as before