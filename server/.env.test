# Test Environment Variables for Database Integration Testing
NODE_ENV=test
MOCK_AUTH=true

# Mock database URLs (these won't work but will enable fallback mode)
SUPABASE_URL=mock://localhost
SUPABASE_ANON_KEY=mock-key
SUPABASE_SERVICE_KEY=mock-service-key

# Enable fallback to JSON files
ENABLE_DUAL_WRITE=false
ENABLE_DATABASE_READ=false
FALLBACK_TO_JSON=true

# Redis (optional)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Mock LLM Configuration
USE_MOCK_LLM=true
MOCK_LLM_DELAY=100
MOCK_ENABLED=true

# Required API keys (can be mock values for testing)
OPENAI_API_KEY=mock-openai-key
ANTHROPIC_API_KEY=mock-anthropic-key
GOOGLE_AI_API_KEY=mock-google-key
GROK_API_KEY=mock-grok-key

CORS_ORIGIN=http://localhost:5173
PORT=3001