# Frontend Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to git!

# Qdrant Vector Database (for frontend if needed)
VITE_QDRANT_URL=https://your-qdrant-instance.gcp.cloud.qdrant.io:6333
VITE_QDRANT_API_KEY=your-qdrant-api-key

# OpenAI (for frontend if needed)
VITE_OPENAI_API_KEY=sk-your-openai-key

# API Backend URL
VITE_API_URL=http://localhost:3001

# Other frontend config
VITE_APP_TITLE="Tala AI"
VITE_ENABLE_ANALYTICS=false