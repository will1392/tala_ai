# Frontend Environment Variables Example
# Copy this to .env.local for development

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_ENV=development

# Google Drive Integration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable Google Drive API and Google Picker API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized JavaScript origins: http://localhost:5173
# 5. Create an API key
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key

# Feature Flags
VITE_FEATURE_DASHBOARD=true
VITE_FEATURE_CHAT=true
VITE_FEATURE_KNOWLEDGE=true
VITE_FEATURE_EMAIL=true
VITE_FEATURE_CMO=true
VITE_FEATURE_MARKETING=true
VITE_FEATURE_SETTINGS=true
