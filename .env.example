# Frontend Environment Variables Example
# Copy this to .env.local for development

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_ENV=development

# Feature Flags
VITE_FEATURE_DASHBOARD=true
VITE_FEATURE_CHAT=true
VITE_FEATURE_KNOWLEDGE=true
VITE_FEATURE_EMAIL=true
VITE_FEATURE_CMO=true
VITE_FEATURE_MARKETING=true
VITE_FEATURE_SETTINGS=true
